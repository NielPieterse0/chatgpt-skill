#!/usr/bin/env python3
"""Local safety net for catalogue publication after a main-branch merge."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


def _git(*args: str) -> str:
    completed = subprocess.run(["git", *args], check=True, capture_output=True, text=True)
    return completed.stdout.strip()


def main() -> int:
    completed = subprocess.run(
        ["git", "symbolic-ref", "--quiet", "--short", "HEAD"],
        check=False,
        capture_output=True,
        text=True,
    )
    if completed.returncode != 0 or completed.stdout.strip() != "main":
        return 0
    repo = Path(_git("rev-parse", "--show-toplevel"))
    result = subprocess.run(
        [sys.executable, str(repo / "scripts" / "sync_workspace_catalogue.py"), "--repo", str(repo), "--source-ref", "HEAD"],
        check=False,
    )
    if result.returncode != 0:
        print(
            "post-merge catalogue synchronization failed; do not treat this skill merge as complete.",
            file=sys.stderr,
        )
    return result.returncode


if __name__ == "__main__":
    raise SystemExit(main())
